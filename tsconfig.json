{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["svelte", "vite/client"],
    "baseUrl": ".",
    "paths": { "$lib": ["src/lib"], "$lib/*": ["src/lib/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
